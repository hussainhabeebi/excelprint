{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excelprint",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Top-level bindings — used by `wrangler deploy` (no --env flag), i.e.
  // this is the environment actually live at the production domain. The
  // `env.preview`/`env.production` blocks below are still placeholders for
  // a future split into separate preview/production Cloudflare
  // environments; not currently used by the deploy command in place.
  // D1/R2/Queue IDs and names are not secrets, but account-level tokens
  // still never belong in this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excelprint-db",
      "database_id": "760c6238-3814-4662-bf12-667d819952c8",
      "migrations_dir": "db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ARTWORK_BUCKET",
      "bucket_name": "excelprint-artwork"
    }
  ],

  // Producers only for now — the app can enqueue messages (e.g.
  // env.AI_DESIGN_QUEUE.send(...)) once that code exists. Consumers are
  // deliberately not declared here: attaching a consumer requires the
  // deployed script to export a `queue()` handler, which only exists once
  // workers/ai-design etc. are implemented (Phase 6+). Declaring a
  // consumer against a script with no queue() handler fails deploy with
  // Cloudflare error 11001 ("Queue handler is missing").
  "queues": {
    "producers": [
      { "binding": "AI_DESIGN_QUEUE", "queue": "excelprint-ai-design" },
      { "binding": "NOTIFICATIONS_QUEUE", "queue": "excelprint-notifications" },
      { "binding": "ARTWORK_PROCESSING_QUEUE", "queue": "excelprint-artwork-processing" },
      { "binding": "ORDER_PROCESSING_QUEUE", "queue": "excelprint-order-processing" }
    ]
  },

  "vars": {
    "APP_ENV": "development"
  },

  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "excelprint-db-preview",
          "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "ARTWORK_BUCKET", "bucket_name": "excelprint-artwork-preview" }
      ],
      "vars": { "APP_ENV": "preview" }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "excelprint-db-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "ARTWORK_BUCKET", "bucket_name": "excelprint-artwork-production" }
      ],
      "vars": { "APP_ENV": "production" }
    }
  }
}
