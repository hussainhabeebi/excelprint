# Copy to .env.local for `next dev`. For Cloudflare Workers deployments,
# set the equivalent values as `wrangler secret put <NAME>` (secrets) or in
# wrangler.jsonc `vars` (non-secret config) per environment — see README.md.
# Never commit a real .env.local or production secret to git.

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# --- Cloudflare ------------------------------------------------------------
# Only needed for drizzle-kit / wrangler CLI commands against a remote D1
# database (db:migrate:preview, db:migrate:production, db:generate against
# a remote DB). Local dev and `wrangler dev` use the local D1 sqlite file
# automatically and don't need these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# --- Cloudflare Turnstile ---------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- fal.ai (AI design generation) -----------------------------------------
FAL_KEY=

# --- Business identity placeholders -----------------------------------------
# Never invent these — leave blank until Excel Printing provides real values.
# Rendered on the homepage/footer/contact pages only when set.
NEXT_PUBLIC_EXCEL_PRINTING_PHONE=
NEXT_PUBLIC_EXCEL_PRINTING_WHATSAPP=
NEXT_PUBLIC_EXCEL_PRINTING_EMAIL=
NEXT_PUBLIC_EXCEL_PRINTING_ADDRESS=
NEXT_PUBLIC_EXCEL_PRINTING_MAPS_URL=
NEXT_PUBLIC_EXCEL_PRINTING_HOURS=
NEXT_PUBLIC_EXCEL_PRINTING_VAT_NUMBER=
